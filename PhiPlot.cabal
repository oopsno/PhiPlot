name:                PhiPlot
version:             0.1.0.0
homepage:            https://github.com/oopsno/PhiPlot
license:             GPL-3
license-file:        LICENSE
author:              Liu Yufei
maintainer:          yufeiliu94@gmail.com
build-type:          Simple
extra-source-files:  ChangeLog.md, README.md
cabal-version:       2.0

library
  hs-source-dirs:      phiplot
  build-depends:       base          >= 4.16 && < 4.17,
                       bytestring    >= 0.11 && < 0.12,
                       parsec        >= 3.1 && < 3.2,
                       GenericPretty >= 1.2 && < 1.3
  exposed-modules:     Language.PhiPlot,
                       Language.PhiPlot.Lexer,
                       Language.PhiPlot.AST,
                       Language.PhiPlot.Parser,
                       Language.PhiPlot.Desugar
  default-language:    Haskell2010


executable PhiPlot
  main-is:             phiplot/Main.hs
  build-depends:       base          >= 4.16 && < 4.17,
                       parsec        >= 3.1 && < 3.2,
                       GenericPretty >= 1.2 && < 1.3,
                       PhiPlot
  default-language:    Haskell2010
