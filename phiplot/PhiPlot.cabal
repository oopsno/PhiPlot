cabal-version:       3.0
name:                PhiPlot
version:             0.1.0.0
homepage:            https://github.com/oopsno/PhiPlot
license:             GPL-3.0-or-later
author:              Liu Yufei
maintainer:          yufeiliu94@gmail.com
build-type:          Simple
extra-source-files:  ChangeLog.md, README.md

common shared
  default-language:    Haskell2010
  build-depends:       base          ^>= 4.20,
                       GenericPretty ^>= 1.2,
                       JuicyPixels   ^>= 3.3,
                       containers    ^>= 0.7,
                       mtl           ^>= 2.3,
                       parsec        ^>= 3.1,
                       primitive     ^>= 0.9,
                       syb           ^>= 0.7,
                       lens          ^>= 5.3,

library
  import: shared
  exposed-modules:     Language.PhiPlot,
                       Language.PhiPlot.AST,
                       Language.PhiPlot.Interpreter,
                       Language.PhiPlot.Lexer,
                       Language.PhiPlot.Parser,
                       Language.PhiPlot.Simplify,

executable PhiPlot
  import: shared
  main-is:            Main.hs
  build-depends:
                      optparse-applicative ^>= 0.19,
  other-modules:
                      Language.PhiPlot.AST,
                      Language.PhiPlot.Interpreter,
                      Language.PhiPlot.Lexer,
                      Language.PhiPlot.Parser,
                      Language.PhiPlot.Simplify,
